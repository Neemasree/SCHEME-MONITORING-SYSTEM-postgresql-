NODE_ENV=development
PORT=5000
DB_NAME=govt_monitoring
DB_USER=postgres
DB_PASSWORD=replace_with_a_local_password
DB_HOST=localhost
DB_PORT=5432
# Use a random secret with at least 32 characters. Never reuse this example in production.
JWT_SECRET=replace_this_with_a_random_secret_at_least_32_chars
JWT_EXPIRES_IN=2h
CLIENT_ORIGIN=http://localhost:5173
SQL_LOGGING=false
DB_POOL_MAX=10
